/**app.wxss**/
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

/* 容器 */
.container {
  padding: 20rpx;
}

/* 按钮 */
.btn-primary {
  background-color: #1890ff;
  color: white;
  border-radius: 8rpx;
}

.btn-secondary {
  background-color: #52c41a;
  color: white;
  border-radius: 8rpx;
}

/* 卡片 */
.card {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 地图容器 */
.map-container {
  width: 100%;
  height: 100%;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

/* 标记 */
.marker {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.marker-icon {
  width: 60rpx;
  height: 60rpx;
}

.marker-label {
  background-color: rgba(255, 255, 255, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  margin-top: 4rpx;
  white-space: nowrap;
}

/* 信息弹窗 */
.info-window {
  background-color: white;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.info-window .title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.info-window .info {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 加载 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading .text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty .icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty .text {
  font-size: 28rpx;
}
