/* pages/navigation/navigation.wxss */
.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 目的地选择面板 */
.destination-panel {
  background-color: white;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
  z-index: 100;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ccc;
  border-radius: 50%;
  font-size: 32rpx;
  color: white;
}

/* 目的地操作按钮 */
.destination-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dest-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background-color: #f8f8f8;
  border-radius: 12rpx;
  border: none;
  font-size: 24rpx;
}

.dest-btn::after {
  border: none;
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.btn-text {
  font-size: 24rpx;
  color: #666;
}

/* 搜索结果列表 */
.search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background-color: white;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  max-height: 500rpx;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10rpx);
  transition: all 0.3s ease;
  z-index: 99;
}

.search-results.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.results-scroll {
  max-height: 500rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.result-address {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.result-distance {
  font-size: 24rpx;
  color: #1890ff;
}

/* 已选目的地 */
.selected-destination {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background-color: #e6f7ff;
  border-radius: 12rpx;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10rpx);
  transition: all 0.3s ease;
}

.selected-destination.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dest-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dest-label {
  font-size: 20rpx;
  color: #1890ff;
  margin-bottom: 4rpx;
}

.dest-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.dest-address {
  font-size: 22rpx;
  color: #666;
  margin-top: 4rpx;
}

.dest-action {
  padding: 8rpx 20rpx;
  background-color: #ff4d4f;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 地图区域 */
.map-wrapper {
  flex: 1;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.location-info {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  right: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-box {
  background-color: rgba(255, 255, 255, 0.95);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.route-info {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  opacity: 0;
  visibility: hidden;
  transform: translateY(20rpx);
  transition: all 0.3s ease;
}

.route-info.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.route-card {
  background-color: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.route-card-scroll {
  max-height: 480rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.route-card-scroll .route-card {
  box-shadow: none;
  border-radius: 0;
}

.route-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.route-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.route-body {
  display: flex;
  padding: 24rpx 30rpx;
}

.route-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.item-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.item-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
}

.route-steps {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.steps-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx dashed #e8e8e8;
}

.step-item {
  display: flex;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.step-left {
  width: 36rpx;
  display: flex;
  align-items: center;
  padding-top: 10rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  background-color: #1890ff;
  border-radius: 50%;
  flex-shrink: 0;
}

.step-right {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.step-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
}

.step-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 操作面板 */
.action-panel {
  background-color: white;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1890ff 0%, #40a9ff 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
}

.action-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

.secondary-row {
  display: flex;
  gap: 16rpx;
}

.secondary-btn {
  flex: 1;
  height: 80rpx;
  background-color: white;
  color: #666;
  font-size: 28rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 12rpx;
}
