<!--pages/navigation/navigation.wxml-->
<view class="container">
  <!-- 搜索和目的地区域 -->
  <view class="destination-panel">
    <!-- 目的地搜索框 -->
    <view class="search-box">
      <view class="search-icon">
        <text>🔍</text>
      </view>
      <input
        class="search-input"
        type="text"
        placeholder="输入目的地（支持校园外任意地点）"
        value="{{destinationText}}"
        bindinput="onDestinationInput"
        bindconfirm="searchDestination"
        confirm-type="search"
      />
      <view class="search-clear" bindtap="clearDestination" wx:if="{{destinationText}}">
        <text>×</text>
      </view>
    </view>

    <!-- 目的地选择方式 -->
    <view class="destination-actions">
      <button class="dest-btn" bindtap="searchDestination">
        <text class="btn-icon">🔍</text>
        <text class="btn-text">搜索</text>
      </button>
      <button class="dest-btn" bindtap="chooseLocationOnMap">
        <text class="btn-icon">📍</text>
        <text class="btn-text">地图选点</text>
      </button>
      <button class="dest-btn" bindtap="chooseFromParking">
        <text class="btn-icon">🅿️</text>
        <text class="btn-text">停车场</text>
      </button>
    </view>

    <!-- 搜索结果列表 -->
    <view class="search-results {{showSearchResults ? 'show' : ''}}" wx:if="{{searchResults.length > 0}}">
      <scroll-view scroll-y class="results-scroll">
        <view class="result-item" wx:for="{{searchResults}}" wx:key="index" bindtap="selectSearchResult" data-index="{{index}}">
          <view class="result-icon">
            <text>📍</text>
          </view>
          <view class="result-info">
            <text class="result-name">{{item.name}}</text>
            <text class="result-address">{{item.address}}</text>
          </view>
          <view class="result-distance" wx:if="{{item.distance_text}}">
            <text>{{item.distance_text}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 已选目的地信息 -->
    <view class="selected-destination {{targetPoint ? 'show' : ''}}" wx:if="{{targetPoint}}">
      <view class="dest-info">
        <text class="dest-label">目的地</text>
        <text class="dest-name">{{targetPoint.name}}</text>
        <text class="dest-address" wx:if="{{targetPoint.address}}">{{targetPoint.address}}</text>
      </view>
      <view class="dest-action" bindtap="clearDestination">
        <text>取消</text>
      </view>
    </view>
  </view>

  <!-- 地图区域 -->
  <view class="map-wrapper">
    <map
      id="navMap"
      class="map"
      longitude="{{longitude}}"
      latitude="{{latitude}}"
      scale="{{scale}}"
      show-location="{{showLocation}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      bindmarkertap="onMarkerTap"
      bindlongpress="onMapLongPress"
    >
    </map>

    <!-- 当前位置信息 -->
    <view class="location-info">
      <view class="info-box">
        <text class="info-label">当前位置</text>
        <text class="info-value">{{currentLocationText}}</text>
      </view>
    </view>

    <!-- 路线信息卡片 -->
    <view class="route-info {{showRoute ? 'show' : ''}}" wx:if="{{routeData}}">
      <scroll-view scroll-y class="route-card-scroll">
        <view class="route-card">
          <view class="route-header">
            <text class="route-title">路线详情</text>
            <text class="route-close" bindtap="hideRouteCard">×</text>
          </view>
          <view class="route-body">
            <view class="route-item">
              <text class="item-label">距离</text>
              <text class="item-value">{{distanceText}}</text>
            </view>
            <view class="route-item">
              <text class="item-label">预计</text>
              <text class="item-value">{{durationText}}</text>
            </view>
          </view>
          <view class="route-steps" wx:if="{{routeData.steps && routeData.steps.length > 0}}">
            <text class="steps-title">导航指引（{{routeData.steps.length}}步）</text>
            <view class="step-item" wx:for="{{routeData.steps}}" wx:key="index">
              <view class="step-left">
                <text class="step-dot"></text>
              </view>
              <view class="step-right">
                <text class="step-text">{{item.instruction}}</text>
                <text class="step-meta" wx:if="{{item.distance}}">{{item.distance}}米</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-panel">
    <button class="action-btn" bindtap="startNavigation" disabled="{{!targetPoint}}">
      {{targetPoint ? '开始导航' : '请选择目的地'}}
    </button>
    <view class="secondary-row">
      <button class="secondary-btn" bindtap="reLocate">
        重新定位
      </button>
      <button class="secondary-btn" bindtap="resetNavigation">
        重置
      </button>
    </view>
  </view>
</view>
