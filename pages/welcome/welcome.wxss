/* pages/welcome/welcome.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.logo {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 60rpx;
  animation: bounce 1s ease-in-out;
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

.welcome-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.greeting {
  font-size: 48rpx;
  color: white;
  margin-bottom: 20rpx;
}

.username {
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
  animation: fadeIn 0.5s ease-in-out;
}

.role {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  animation: fadeIn 0.5s ease-in-out 0.3s both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.school-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.school {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.department {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
