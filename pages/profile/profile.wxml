<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 未登录：游客模式 -->
  <view class="guest-card" wx:if="{{!isLogin}}">
    <view class="guest-avatar">
      <text class="guest-avatar-icon">👤</text>
    </view>
    <text class="guest-title">您好，游客</text>
    <text class="guest-desc">登录后可享受完整功能体验</text>
    <button class="login-btn" bindtap="goToLogin">立即登录</button>
  </view>

  <!-- 已登录：用户信息卡片 -->
  <view class="user-card" wx:if="{{isLogin}}">
    <view class="avatar-section" bindtap="previewAvatar">
      <image 
        class="avatar" 
        src="{{userInfo.avatar || '/images/logo.png'}}" 
        mode="aspectFill"
      ></image>
      <view class="avatar-mask">
        <text class="avatar-icon">👤</text>
      </view>
    </view>
    
    <view class="user-info">
      <text class="nickname">{{userInfo.nickname || '未设置'}}</text>
      <text class="real-name">{{userInfo.realName ? userInfo.realName : '点击完善个人信息'}}</text>
    </view>
  </view>

  <!-- 功能菜单（游客和登录用户都可见） -->
  <view class="menu-list">
    <view 
      class="menu-item" 
      wx:for="{{menuList}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="handleMenuClick"
    >
      <view class="menu-content">
        <text class="menu-icon">{{item.icon === 'edit' ? '✏️' : item.icon === 'privacy' ? '🔒' : 'ℹ️'}}</text>
        <text class="menu-title">{{item.title}}</text>
      </view>
      <text class="menu-arrow" wx:if="{{item.arrow}}">›</text>
    </view>
  </view>

  <!-- 退出登录按钮（关于下方） -->
  <view class="logout-section" wx:if="{{isLogin}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
