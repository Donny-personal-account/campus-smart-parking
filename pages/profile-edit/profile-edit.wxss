/* pages/profile-edit/profile-edit.wxss */
.edit-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头像区域 */
.section {
  background-color: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  align-self: flex-start;
}

.avatar-button {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  background: none;
  border: none;
  border-radius: 100rpx;
  overflow: hidden;
}

.avatar-button::after {
  border: none;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 100rpx;
  border: 4rpx solid #e8e8e8;
  background-color: #f5f5f5;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.avatar-button:active .avatar-mask {
  opacity: 1;
}

.avatar-tip {
  color: #fff;
  font-size: 24rpx;
}

/* 表单区域 */
.form-section {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 32rpx;
  color: #666;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  text-align: right;
}

.input::placeholder {
  color: #999;
}

/* 按钮区域 */
.btn-section {
  padding: 40rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1890ff;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 0;
}

.save-btn:active {
  background-color: #096dd9;
}
